# Copy this file to .env.local and paste your values after each "=".
# .env.local is ignored by git, so your keys never get committed.
# Restart `npm run dev` after editing it.

# Supabase dashboard > your project > Connect (or Project Settings > API Keys).
# Project URL, for example https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key, which starts with sb_publishable_. Never paste the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud console > APIs & Services > Credentials > your API key.
# In the key settings: Application restrictions = None, API restrictions = Restrict key > Places API (New).
# Our server makes every Places call, so this key never reaches the browser.
GOOGLE_PLACES_API_KEY=

# The Google sign-in Client ID and Client Secret do NOT go in this file.
# Paste them in the Supabase dashboard under Authentication > Sign In / Providers > Google.

# Optional, for automated browser checks only (scripts/test-session.mjs).
# Create the user in Supabase > Authentication > Users > Add user, with Auto Confirm User checked.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
